<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/screen_background">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_top_bar">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_loki_crown"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/appTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LOKI"
                    android:textColor="@color/gold"
                    android:textSize="18sp"
                    android:fontFamily="sans"
                    android:letterSpacing="0.055"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:text="C I N E M A"
                    android:textColor="@color/gold"
                    android:textSize="9sp"
                    android:letterSpacing="0.13"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/castButton"
                android:layout_width="38dp"
                android:layout_height="39dp"
                android:layout_marginEnd="4dp"
                android:padding="8dp"
                android:background="@drawable/bg_button_dark"
                android:stateListAnimator="@null"
                android:src="@drawable/ic_cast"
                android:scaleType="fitCenter"
                android:contentDescription="Espelhar tela na TV" />

            <Button
                android:id="@+id/watchedButton"
                android:layout_width="76dp"
                android:layout_height="39dp"
                android:minWidth="0dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="3dp"
                android:paddingEnd="5dp"
                android:background="@drawable/bg_button_dark"
                android:stateListAnimator="@null"
                android:text="♡ ASSISTIDOS"
                android:textAllCaps="false"
                android:textColor="@color/status_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/updateButton"
                android:layout_width="78dp"
                android:layout_height="39dp"
                android:minWidth="0dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:background="@drawable/bg_button_accent"
                android:stateListAnimator="@null"
                android:text="@string/update_button"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gold_divider" />

        <ProgressBar
            android:id="@+id/updateProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@color/top_bar"
            android:textColor="@color/status_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <WebView
            android:id="@+id/siteWeb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/screen_background" />

        <LinearLayout
            android:id="@+id/navigationBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/bg_navigation">

            <Button
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="43dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_dark"
                android:stateListAnimator="@null"
                android:text="‹   Voltar"
                android:textAllCaps="false"
                android:textColor="@color/status_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/forwardButton"
                android:layout_width="0dp"
                android:layout_height="43dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_dark"
                android:stateListAnimator="@null"
                android:text="Avançar   ›"
                android:textAllCaps="false"
                android:textColor="@color/status_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />
</FrameLayout>